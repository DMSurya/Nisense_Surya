/* PWM group: controller + pinctrl */
&pinctrl {
	pwm1_buzzer: pwm1_buzzer {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 12)>;
		};
	};

	pwm1_buzzer_sleep: pwm1_buzzer_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 12)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	status = "disabled";
};

&pwm1 {
	status = "okay";
	pinctrl-0 = <&pwm1_buzzer>;
	pinctrl-1 = <&pwm1_buzzer_sleep>;
	pinctrl-names = "default", "sleep";
};
