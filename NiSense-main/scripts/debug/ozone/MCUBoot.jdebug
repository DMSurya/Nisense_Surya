/*********************************************************************
*
*       _SetupTarget
*
* Function description
*   Setup the target to boot directly into the application.
*   LEGACY: Use _SetupTarget_MCUboot() for proper boot chain.
*
*   Auto-generated function. May be overridden by Ozone.
*
**********************************************************************
*/
void _SetupTarget(void) {
  unsigned int SP;
  unsigned int PC;
  unsigned int VectorTableAddr;

  VectorTableAddr = Elf.GetBaseAddr();
  //
  // Set up initial stack pointer
  //
  SP = Target.ReadU32(VectorTableAddr);
  if (SP != 0xFFFFFFFF) {
    Target.SetReg("SP", SP);
  }
  //
  // Set up entry point PC
  //
  PC = Elf.GetEntryPointPC();
  if (PC != 0xFFFFFFFF) {
    Target.SetReg("PC", PC);
  } else {
    Util.Error("Project script error: failed to set up entry point PC", 1);
  }
}

/*********************************************************************
*
*       _SetupTarget_MCUboot
*
* Function description
*   Setup the target to boot from MCUboot (proper boot chain).
*   MCUboot is located at address 0x0 and will validate the app
*   image before jumping to it.
*
*   This allows debugging the full boot sequence:
*   MCUboot → Image validation → Jump to application
*
**********************************************************************
*/
void _SetupTarget_MCUboot(void) {
  unsigned int SP;
  unsigned int PC;
  unsigned int MCUbootAddr;

  //
  // MCUboot is at address 0x0 (start of internal flash)
  //
  MCUbootAddr = 0x00000000;

  //
  // Read SP from MCUboot vector table (first word at 0x0)
  //
  SP = Target.ReadU32(MCUbootAddr);
  if (SP == 0xFFFFFFFF || SP == 0x00000000) {
    Util.Error("Failed to read MCUboot stack pointer from 0x0", 1);
  } else {
    Target.SetReg("SP", SP);
    Util.LogHex("MCUboot SP: 0x", SP);

    //
    // Read Reset Handler address from MCUboot vector table (second word at 0x4)
    //
    PC = Target.ReadU32(MCUbootAddr + 4);
    if (PC == 0xFFFFFFFF || PC == 0x00000000) {
      Util.Error("Failed to read MCUboot reset vector from 0x4", 1);
    } else {
      Target.SetReg("PC", PC);
      Util.LogHex("MCUboot Reset Handler: 0x", PC);
      Util.Log("Booting from MCUboot...");
    }
  }
}

/*********************************************************************
*
*       BootDirectToApp
*
* Function description
*   Skip MCUboot and boot directly into the application.
*   Useful for faster iteration when not testing boot chain.
*   Call from Ozone console: exec BootDirectToApp()
*
**********************************************************************
*/
void BootDirectToApp(void) {
  unsigned int SP;
  unsigned int PC;
  unsigned int AppAddr;

  //
  // Application vector table is at 0xA200 (after MCUboot header)
  //
  AppAddr = 0x0000A200;

  SP = Target.ReadU32(AppAddr);
  PC = Target.ReadU32(AppAddr + 4);

  if (SP != 0xFFFFFFFF && PC != 0xFFFFFFFF) {
    Target.SetReg("SP", SP);
    Target.SetReg("PC", PC);
    Util.Log("Direct boot to app: SP=0x" + Util.IntToHex(SP, 8) + ", PC=0x" + Util.IntToHex(PC, 8));
  } else {
    Util.Error("Failed to read app vectors at 0xA200", 1);
  }
}

/*********************************************************************
*
*       ShowMemoryMap
*
* Function description
*   Display the memory map in the log.
*   Call from Ozone console: exec ShowMemoryMap()
*
**********************************************************************
*/
void ShowMemoryMap(void) {
  Util.Log("================ MEMORY MAP ================");
  Util.Log("INTERNAL FLASH (1 MB):");
  Util.Log("  0x00000000 - 0x0000A000: MCUboot (40 KB)");
  Util.Log("  0x0000A000 - 0x0000A200: MCUboot Header (512 B)");
  Util.Log("  0x0000A200 - 0x000EFBF8: Application (~918 KB)");
  Util.Log("  0x000F0000 - 0x000FA000: mcuboot_primary_app (Image 0)");
  Util.Log("  0x000FA000 - 0x00100000: NVS Storage (24 KB)");
  Util.Log("");
  Util.Log("SRAM (256 KB):");
  Util.Log("  0x20000000 - 0x20040000: RAM");
  Util.Log("");
  Util.Log("EXTERNAL FLASH (8 MB QSPI @ 0x12000000 XIP base):");
  Util.Log("  0x000000 - 0x0F2000: mcuboot_secondary (968 KB) - App OTA");
  Util.Log("  0x0F2000 - 0x0F6000: mcuboot_scratch (16 KB)");
  Util.Log("  0x0F6000 - 0x176000: resource-primary (512 KB) - QSPI mmap");
  Util.Log("  0x176000 - 0x1F6000: resource-secondary (512 KB) - Resource OTA");
  Util.Log("  0x1F6000 - 0x206000: calibration_model (64 KB)");
  Util.Log("  0x206000 - 0x216000: storage_nvs (64 KB)");
  Util.Log("  0x216000 - 0x800000: userdata_storage (6.0 MB) - FAT32/MSC");
  Util.Log("");
  Util.Log("XIP MEMORY-MAPPED ACCESS:");
  Util.Log("  XIP Base: 0x12000000");
  Util.Log("  resource: 0x120F6000 (0x12000000 + 0x0F6000)");
  Util.Log("=============================================");
}

