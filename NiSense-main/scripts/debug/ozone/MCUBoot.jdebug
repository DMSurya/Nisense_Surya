/*********************************************************************
*
*       TargetDownload
*
* Function description
*   Replaces the default program download routine.
*   Downloads merged.hex (MCUboot + App) for full boot chain.
*
**********************************************************************
*/
void TargetDownload (void) {
  //
  // Flash the merged hex file containing both MCUboot and application
  // This ensures proper MCUboot header and signature are in place
  //
  Util.Log("Downloading merged.hex (MCUboot + Application)...");
  Target.LoadMemory("$(ProjectDir)/build_sdk_v330/merged.hex", 0x00000000);
  Util.Log("Download complete.");
}

