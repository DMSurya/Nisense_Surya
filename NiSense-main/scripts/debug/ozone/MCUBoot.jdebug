Ozone Version : V3.38g

Modified      : Jan 2026 - MCUboot boot chain + RTT debugging support

===============================================================================
DEBUGGING WORKFLOW:
===============================================================================
1. F4 (Download & Reset) - Flashes merged.hex and resets to MCUboot
2. F5 (Start & Break)    - Run until main() or first breakpoint
3. Terminal > New Terminal > RTT Channel 0 - View log output

MCUBOOT DEBUGGING:
- MCUboot: 0x00000000 - 0x0000A000 (40 KB)
- App:     0x0000A200 - 0x000FA000 (~960 KB)
- To debug MCUboot itself: File > Open > mcuboot/zephyr/zephyr.elf

HOT KEYS:
- F4:  Download & Reset
- F5:  Start & Break (at main)
- F6:  Step Over
- F7:  Step Into
- F8:  Step Out
- F9:  Toggle Breakpoint
- F12: Reset
===============================================================================
*/

/*********************************************************************
*
*       OnProjectLoad
*
* Function description
*   Project load routine. Required.
*
**********************************************************************
*/
void OnProjectLoad (void) {
  Edit.SysVar (VAR_RTT_ENABLED, 1);
  //
  // Dialog-generated settings
  //
  Project.AddPathSubstitute ("E:/AARMS/HCM/NiSense", "$(ProjectDir)");
  Project.AddPathSubstitute ("e:/aarms/hcm/NiSense", "$(ProjectDir)");
  Project.SetDevice ("nRF52840_xxAA");
  Project.SetHostIF ("USB", "1050275963");
  Project.SetTargetIF ("SWD");
  Project.SetTIFSpeed ("4 MHz");
  Project.AddSvdFile ("$(InstallDir)/Config/CPU/Cortex-M4F.svd");
  //
  // nRF52840 peripherals SVD for register inspection
  //
  // Project.AddSvdFile ("$(ProjectDir)/model/Peripherals/nRF52840.svd");
  //
  // User settings - Load application ELF for symbols
  //
  File.Open ("$(ProjectDir)/build_sdk_v330/mcuboot/zephyr/zephyr.elf");
  //
  // Zephyr OS awareness plugin (thread info, kernel objects)
  //
  Project.SetOSPlugin("ZephyrPlugin.js");
  //
  // RTT Control Block auto-detection (SEGGER RTT)
  // Note: RTT is configured automatically by Ozone when connecting
  //
}

