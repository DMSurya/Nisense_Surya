/*********************************************************************
*
*       FlashCalibration
*
* Function description
*   Flash calibration data to external QSPI flash.
*   Call from Ozone console: exec FlashCalibration()
*   
*   Expected binary: build_sdk_v330/calibration.bin
*   Target offset: 0x1F6000 (calibration partition)
*
* WARNING: 
*   Calibration data is production-locked and should only
*   be programmed once during manufacturing!
*
**********************************************************************
*/
void FlashCalibration(void) {
  Util.Log("============ FLASH CALIBRATION =============");
  Util.Log("Binary:  $(ProjectDir)/build_sdk_v330/calibration.bin");
  Util.Log("Target:  External QSPI flash @ 0x1F6000");
  Util.Log("");
  Util.Log("WARNING: Calibration data is production-locked!");
  Util.Log("         This should only be done during manufacturing.");
  Util.Log("");
  
  Target.Halt();
  
  Util.Log("Programming calibration partition...");
  Exec.Command("loadfile $(ProjectDir)/build_sdk_v330/calibration.bin 0x1F6000 QSPI");
  
  Util.Log("Calibration data programmed.");
  Util.Log("=============================================");
}

/*********************************************************************
*
*       VerifyResource
*
* Function description
*   Verify Resource store is accessible via QSPI mmap.
*   Call from Ozone console: exec VerifyResource()
*
**********************************************************************
*/
void VerifyResource(void) {
  unsigned int magic;
  unsigned int version;
  unsigned int asset_count;
  unsigned int crc;
  
  Util.Log("============ VERIFY RESOURCE STORE =============");
  Util.Log("Reading from XIP address 0x120F4000...");
  
  //
  // Read XIP partition header fields
  // See include/resource.h for structure definition
  //
  magic = Target.ReadU32(0x120F4000);        // offset 0: magic
  version = Target.ReadU32(0x120F4000 + 4);  // offset 4: version  
  asset_count = Target.ReadU32(0x120F4000 + 8);  // offset 8: asset_count
  crc = Target.ReadU32(0x120F4000 + 12);     // offset 12: crc32
  
  Util.Log("");
  Util.Log("XIP Partition Header:");
  Util.Log("  Magic:       0x" + Util.IntToHex(magic, 8) + " (expect 0x58495041 = 'XIPA')");
  Util.Log("  Version:     " + version);
  Util.Log("  Asset Count: " + asset_count);
  Util.Log("  CRC32:       0x" + Util.IntToHex(crc, 8));
  Util.Log("");
  
  if (magic == 0x58495041) {
    Util.Log("Resource header VALID - assets accessible via QSPI mmap!");
  } else if (magic == 0xFFFFFFFF) {
    Util.Log("XIP partition is ERASED (0xFFFFFFFF) - no assets flashed");
  } else {
    Util.Log("XIP header INVALID - may be corrupted or wrong format");
  }
  
  Util.Log("=============================================");
}

/*********************************************************************
*
*       CheckBootStatus
*
* Function description
*   Check MCUboot and application boot status.
*   Call from Ozone console: exec CheckBootStatus()
*
**********************************************************************
*/
void CheckBootStatus(void) {
  unsigned int mcuboot_sp;
  unsigned int mcuboot_pc;
  unsigned int app_sp;
  unsigned int app_pc;
  unsigned int current_pc;

  mcuboot_sp = Target.ReadU32(0x00000000);
  mcuboot_pc = Target.ReadU32(0x00000004);
  app_sp = Target.ReadU32(0x0000A200);
  app_pc = Target.ReadU32(0x0000A204);
  current_pc = Target.GetReg("PC");

  Util.Log("============= BOOT STATUS =============");
  Util.Log("MCUboot Vector Table (0x0):");
  Util.Log("  SP: 0x" + Util.IntToHex(mcuboot_sp, 8));
  Util.Log("  PC: 0x" + Util.IntToHex(mcuboot_pc, 8));
  Util.Log("");
  Util.Log("App Vector Table (0xA200):");
  Util.Log("  SP: 0x" + Util.IntToHex(app_sp, 8));
  Util.Log("  PC: 0x" + Util.IntToHex(app_pc, 8));
  Util.Log("");
  Util.Log("Current PC: 0x" + Util.IntToHex(current_pc, 8));
  
  if (current_pc < 0x0000A000) {
    Util.Log("Status: Running in MCUboot");
  } else if (current_pc >= 0x0000A200 && current_pc < 0x000FA000) {
    Util.Log("Status: Running in Application");
  } else {
    Util.Log("Status: Unknown region");
  }
  Util.Log("=======================================");
}

/*********************************************************************
*
*       AnalyzeFault
*
* Function description
*   Comprehensive fault analysis for HardFault/BusFault/etc.
*   Call from Ozone console when stopped on fault: exec AnalyzeFault()
*
*   ARM Cortex-M4 Fault Status Registers:
*   - CFSR (0xE000ED28): Combined Fault Status Register
*     - MMFSR (bits 7:0): MemManage Fault Status
*     - BFSR (bits 15:8): BusFault Status
*     - UFSR (bits 31:16): UsageFault Status
*   - HFSR (0xE000ED2C): HardFault Status Register
*   - DFSR (0xE000ED30): Debug Fault Status Register
*   - MMFAR (0xE000ED34): MemManage Fault Address
*   - BFAR (0xE000ED38): BusFault Address
*
**********************************************************************
*/
void AnalyzeFault(void) {
  unsigned int pc;
  unsigned int lr;
  unsigned int sp;
  unsigned int cfsr;
  unsigned int hfsr;
  unsigned int mmfar;
  unsigned int bfar;
  unsigned int vtor;
  unsigned int psp;
  unsigned int msp;
  unsigned int control;
  unsigned int primask;

  // Core registers
  pc = Target.GetReg("PC");
  lr = Target.GetReg("LR");
  sp = Target.GetReg("SP");
  psp = Target.GetReg("PSP");
  msp = Target.GetReg("MSP");
  control = Target.GetReg("CONTROL");
  primask = Target.GetReg("PRIMASK");

  // Fault status registers
  cfsr = Target.ReadU32(0xE000ED28);   // CFSR
  hfsr = Target.ReadU32(0xE000ED2C);   // HFSR
  mmfar = Target.ReadU32(0xE000ED34);  // MMFAR
  bfar = Target.ReadU32(0xE000ED38);   // BFAR
  vtor = Target.ReadU32(0xE000ED08);   // VTOR (Vector Table Offset)

  Util.Log("=============== FAULT ANALYSIS ===============");
  Util.Log("");
  
  Util.Log("CORE REGISTERS:");
  Util.Log("  PC (Program Counter): 0x" + Util.IntToHex(pc, 8));
  Util.Log("  LR (Link Register):   0x" + Util.IntToHex(lr, 8));
  Util.Log("  SP (Stack Pointer):   0x" + Util.IntToHex(sp, 8));
  Util.Log("  MSP (Main SP):        0x" + Util.IntToHex(msp, 8));
  Util.Log("  PSP (Process SP):     0x" + Util.IntToHex(psp, 8));
  Util.Log("  CONTROL:              0x" + Util.IntToHex(control, 8));
  Util.Log("  PRIMASK:              0x" + Util.IntToHex(primask, 8));
  Util.Log("  VTOR:                 0x" + Util.IntToHex(vtor, 8));
  Util.Log("");

  // Determine execution context
  if (pc < 0x0000A000) {
    Util.Log("CONTEXT: PC is in MCUboot region (0x0 - 0xA000)");
  } else if (pc >= 0x0000A200 && pc < 0x000FA000) {
    Util.Log("CONTEXT: PC is in Application region (0xA200 - 0xFA000)");
  } else if (pc >= 0xE0000000) {
    Util.Log("CONTEXT: PC is in System/Debug region");
  } else {
    Util.Log("CONTEXT: PC is in UNKNOWN region - possible corruption!");
  }
  Util.Log("");

  // VTOR check
  if (vtor == 0x00000000) {
    Util.Log("VTOR WARNING: Vector table at 0x0 (MCUboot)");
    Util.Log("  This is WRONG if app is running - should be 0xA200!");
  } else if (vtor == 0x0000A200) {
    Util.Log("VTOR OK: Vector table at 0xA200 (Application)");
  }
  Util.Log("");

  Util.Log("FAULT STATUS REGISTERS:");
  Util.Log("  CFSR: 0x" + Util.IntToHex(cfsr, 8));
  Util.Log("  HFSR: 0x" + Util.IntToHex(hfsr, 8));
  Util.Log("  BFAR: 0x" + Util.IntToHex(bfar, 8));
  Util.Log("  MMFAR: 0x" + Util.IntToHex(mmfar, 8));
  Util.Log("");

  // Decode HFSR
  Util.Log("HFSR DECODE:");
  if (hfsr & 0x40000000) {
    Util.Log("  [FORCED] - Escalated from configurable fault");
  }
  if (hfsr & 0x00000002) {
    Util.Log("  [VECTTBL] - Vector table read error");
  }
  if (hfsr & 0x80000000) {
    Util.Log("  [DEBUGEVT] - Debug event occurred");
  }
  Util.Log("");

  // Decode CFSR - BusFault Status (bits 15:8)
  Util.Log("BUSFAULT STATUS (BFSR):");
  if (cfsr & 0x8000) {
    Util.Log("  [BFARVALID] - BFAR contains valid address: 0x" + Util.IntToHex(bfar, 8));
  }
  if (cfsr & 0x1000) {
    Util.Log("  [LSPERR] - Fault during lazy FP state preservation");
  }
  if (cfsr & 0x0800) {
    Util.Log("  [STKERR] - Stack error during exception entry");
  }
  if (cfsr & 0x0400) {
    Util.Log("  [UNSTKERR] - Stack error during exception return");
  }
  if (cfsr & 0x0200) {
    Util.Log("  [IMPRECISERR] - Imprecise data access violation");
  }
  if (cfsr & 0x0100) {
    Util.Log("  [PRECISERR] - Precise data access violation");
  }
  if (cfsr & 0x0100) {
    Util.Log("    Faulting address (if BFARVALID): 0x" + Util.IntToHex(bfar, 8));
  }
  Util.Log("");

  // Decode CFSR - UsageFault Status (bits 31:16)
  Util.Log("USAGEFAULT STATUS (UFSR):");
  if (cfsr & 0x02000000) {
    Util.Log("  [DIVBYZERO] - Division by zero");
  }
  if (cfsr & 0x01000000) {
    Util.Log("  [UNALIGNED] - Unaligned access");
  }
  if (cfsr & 0x00080000) {
    Util.Log("  [NOCP] - No coprocessor");
  }
  if (cfsr & 0x00040000) {
    Util.Log("  [INVPC] - Invalid PC load");
  }
  if (cfsr & 0x00020000) {
    Util.Log("  [INVSTATE] - Invalid state (Thumb bit)");
  }
  if (cfsr & 0x00010000) {
    Util.Log("  [UNDEFINSTR] - Undefined instruction");
  }
  Util.Log("");

  // Decode CFSR - MemManage Fault Status (bits 7:0)
  Util.Log("MEMMANAGE STATUS (MMFSR):");
  if (cfsr & 0x80) {
    Util.Log("  [MMARVALID] - MMFAR contains valid address: 0x" + Util.IntToHex(mmfar, 8));
  }
  if (cfsr & 0x20) {
    Util.Log("  [MLSPERR] - Lazy FP state preservation fault");
  }
  if (cfsr & 0x10) {
    Util.Log("  [MSTKERR] - Stack error on exception entry");
  }
  if (cfsr & 0x08) {
    Util.Log("  [MUNSTKERR] - Stack error on exception return");
  }
  if (cfsr & 0x02) {
    Util.Log("  [DACCVIOL] - Data access violation");
  }
  if (cfsr & 0x01) {
    Util.Log("  [IACCVIOL] - Instruction access violation");
  }
  Util.Log("");

  // Examine stacked registers
  Util.Log("EXCEPTION STACK FRAME (at SP):");
  Util.Log("  R0:  0x" + Util.IntToHex(Target.ReadU32(sp + 0), 8));
  Util.Log("  R1:  0x" + Util.IntToHex(Target.ReadU32(sp + 4), 8));
  Util.Log("  R2:  0x" + Util.IntToHex(Target.ReadU32(sp + 8), 8));
  Util.Log("  R3:  0x" + Util.IntToHex(Target.ReadU32(sp + 12), 8));
  Util.Log("  R12: 0x" + Util.IntToHex(Target.ReadU32(sp + 16), 8));
  Util.Log("  LR:  0x" + Util.IntToHex(Target.ReadU32(sp + 20), 8) + " (Return address)");
  Util.Log("  PC:  0x" + Util.IntToHex(Target.ReadU32(sp + 24), 8) + " (Faulting PC)");
  Util.Log("  xPSR: 0x" + Util.IntToHex(Target.ReadU32(sp + 28), 8));
  Util.Log("");

  // Check if faulting PC is in MCUboot or App
  unsigned int faulting_pc = Target.ReadU32(sp + 24);
  if (faulting_pc < 0x0000A000) {
    Util.Log("*** FAULTING PC is in MCUboot region! ***");
    Util.Log("    This is unexpected if app should be running.");
    Util.Log("    Possible causes:");
    Util.Log("    - VTOR not updated to app vector table");
    Util.Log("    - Stack corruption with MCUboot return address");
    Util.Log("    - Function pointer corruption");
  }

  Util.Log("==============================================");
}

/*********************************************************************
*
*       CheckVTOR
*
* Function description
*   Quick check of VTOR register to see which vector table is active.
*   Call from Ozone console: exec CheckVTOR()
*
**********************************************************************
*/
void CheckVTOR(void) {
  unsigned int vtor = Target.ReadU32(0xE000ED08);
  
  Util.Log("VTOR (Vector Table Offset): 0x" + Util.IntToHex(vtor, 8));
  
  if (vtor == 0x00000000) {
    Util.Log("  -> MCUboot vector table (address 0x0)");
    Util.Log("  WARNING: If app is running, this should be 0xA200!");
  } else if (vtor == 0x0000A200) {
    Util.Log("  -> Application vector table (address 0xA200)");
    Util.Log("  This is correct for app execution.");
  } else {
    Util.Log("  -> UNKNOWN vector table location!");
  }
}
