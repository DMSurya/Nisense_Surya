# Copy to .env.local for local dev. In dev the Vite proxy forwards /api and
# /auth, so VITE_API_BASE can stay as the default same-origin path.

# API base (default: /api/v1 via Vite proxy / Caddy)
# VITE_API_BASE=/api/v1

# OIDC (SSO) — Keycloak realm (absolute in prod; same-origin /auth via Caddy)
# Local Vite: leave unset to use window.location.origin + /auth/realms/nisense
# VITE_OIDC_AUTHORITY=https://mpsaami.ddns.net/auth/realms/nisense
VITE_OIDC_CLIENT_ID=nisense-web

