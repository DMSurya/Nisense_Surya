# Copy to .env and adjust. NEVER commit the real .env.

# --- Postgres (compose) ---
POSTGRES_USER=nisense
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nisense

# --- Keycloak (compose) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KC_HOSTNAME=mpsaami.ddns.net
# Pi (~1 GiB RAM): keep heap low. Cloud: e.g. -Xms256m -Xmx768m
JAVA_OPTS_KC_HEAP="-Xms64m -Xmx256m"

# --- Google IdP (optional; enables Google button when both set) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URI:
#   https://mpsaami.ddns.net/auth/realms/nisense/broker/google/endpoint
# GOOGLE_OIDC_CLIENT_ID=
# GOOGLE_OIDC_CLIENT_SECRET=

# --- Microsoft IdP (optional; Azure AD app registration) ---
# Redirect URI:
#   https://mpsaami.ddns.net/auth/realms/nisense/broker/microsoft/endpoint
# MICROSOFT_OIDC_CLIENT_ID=
# MICROSOFT_OIDC_CLIENT_SECRET=
# MICROSOFT_OIDC_TENANT_ID=common

# --- API (app/config.py, prefix NISENSE_) ---
NISENSE_ENV=dev
NISENSE_LOG_LEVEL=INFO
NISENSE_PUBLIC_BASE_URL=https://mpsaami.ddns.net

# Identity: dev | keycloak | cognito | azuread
# Pi smoke test: leave as `dev`. After Keycloak is up, switch to `keycloak`.
NISENSE_OIDC_PROVIDER=dev
NISENSE_OIDC_ISSUER=https://mpsaami.ddns.net/auth/realms/nisense
NISENSE_OIDC_AUDIENCE=account
NISENSE_DEV_JWT_SECRET=change-me-dev-secret

# Storage: local | s3
NISENSE_STORAGE_BACKEND=local
NISENSE_STORAGE_LOCAL_DIR=/data/artifacts
# NISENSE_S3_BUCKET=nisense-artifacts
# NISENSE_S3_ENDPOINT_URL=            # set for Azure Blob / MinIO; empty = AWS S3
# NISENSE_S3_REGION=us-east-1

# Model signing
NISENSE_MODEL_SIGNING_PUBKEY_PATH=/data/keys/model_ed25519_pub.pem
NISENSE_REQUIRE_SIGNED_MODELS=false
