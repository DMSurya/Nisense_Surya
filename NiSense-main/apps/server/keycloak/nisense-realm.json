{
  "id": "nisense",
  "realm": "nisense",
  "enabled": true,
  "displayName": "NiSense Digital Health Ecosystem",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyInitialCounter": 0,
  "browserFlow": "browser",
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30
    }
  ],
  "roles": {
    "realm": [
      { "name": "super_admin", "description": "All access" },
      { "name": "clinical_trial_admin", "description": "Trial management" },
      { "name": "doctor", "description": "Patient dashboards + reports" },
      { "name": "investigator", "description": "Trial data" },
      { "name": "patient", "description": "Personal dashboard" },
      { "name": "device_engineer", "description": "Device management" },
      { "name": "ai_analyst", "description": "Model training" }
    ]
  },
  "defaultRoles": ["patient"],
  "clients": [
    {
      "clientId": "nisense-web",
      "name": "NiSense Web Dashboard",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://mpsaami.ddns.net/*##http://localhost:5173/*"
      },
      "redirectUris": [
        "https://mpsaami.ddns.net/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "https://mpsaami.ddns.net",
        "http://localhost:5173"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": ["offline_access", "address", "phone"]
    },
    {
      "clientId": "nisense-mobile",
      "name": "NiSense Mobile App",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "com.aarms.hcm://oauthredirect",
        "nisense://oauthredirect"
      ],
      "webOrigins": ["+"],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ]
    },
    {
      "clientId": "nisense-api",
      "name": "NiSense API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "clientScopes": [
    {
      "name": "roles",
      "description": "OpenID Connect scope for realm roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "user.attribute": "foo",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_OIDC_CLIENT_ID}",
        "clientSecret": "${GOOGLE_OIDC_CLIENT_SECRET}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT",
        "useJwksUrl": "true",
        "guiOrder": "1"
      }
    },
    {
      "alias": "microsoft",
      "displayName": "Microsoft",
      "providerId": "oidc",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${MICROSOFT_OIDC_CLIENT_ID}",
        "clientSecret": "${MICROSOFT_OIDC_CLIENT_SECRET}",
        "authorizationUrl": "https://login.microsoftonline.com/${MICROSOFT_OIDC_TENANT_ID}/oauth2/v2.0/authorize",
        "tokenUrl": "https://login.microsoftonline.com/${MICROSOFT_OIDC_TENANT_ID}/oauth2/v2.0/token",
        "jwksUrl": "https://login.microsoftonline.com/${MICROSOFT_OIDC_TENANT_ID}/discovery/v2.0/keys",
        "userInfoUrl": "https://graph.microsoft.com/oidc/userinfo",
        "logoutUrl": "https://login.microsoftonline.com/${MICROSOFT_OIDC_TENANT_ID}/oauth2/v2.0/logout",
        "issuer": "https://login.microsoftonline.com/${MICROSOFT_OIDC_TENANT_ID}/v2.0",
        "defaultScope": "openid profile email",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "syncMode": "IMPORT",
        "guiOrder": "2"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "google-email-verified",
      "identityProviderAlias": "google",
      "identityProviderMapper": "hardcoded-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute": "emailVerified",
        "attribute.value": "true"
      }
    },
    {
      "name": "microsoft-email-verified",
      "identityProviderAlias": "microsoft",
      "identityProviderMapper": "hardcoded-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute": "emailVerified",
        "attribute.value": "true"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@nisense.local",
      "emailVerified": true,
      "firstName": "NiSense",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "ChangeMeOnFirstLogin!",
          "temporary": true
        }
      ],
      "realmRoles": ["super_admin"]
    }
  ]
}
