# Caddy reverse proxy.
# - Public hostname uses Let's Encrypt when container DNS works.
# - :80 HTTP site always serves API/web for LAN / SSH-tunnel smoke tests.

{
	# Prefer Google DNS if the Docker embedded resolver flakes.
	servers {
		protocols h1 h2
	}
}

# LAN / tunnel smoke test (no TLS)
:80 {
	encode zstd gzip

	handle /auth* {
		reverse_proxy keycloak:8080
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /healthz {
		reverse_proxy api:8000
	}
	handle /readyz {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

# Public HTTPS when ACME succeeds (router forwards 443)
mpsaami.ddns.net {
	encode zstd gzip

	handle /auth* {
		reverse_proxy keycloak:8080
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /healthz {
		reverse_proxy api:8000
	}
	handle /readyz {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}
