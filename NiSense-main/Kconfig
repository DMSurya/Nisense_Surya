	bool "PPG measurement pipeline (umbrella)"
	default n
	depends on APP_FEATURE_MAX32664 || APP_FEATURE_MAX3010X
	imply PPG_ALGO
	select UI_SCREEN_VITALS if APP_FEATURE_DISPLAY
	select UI_SCREEN_VASCULAR if APP_FEATURE_DISPLAY
	select PPG_ALGO_HR_ENABLED if PPG_ALGO
	select PPG_ALGO_SPO2_ENABLED if PPG_ALGO

config PPG_LOG_DC_AC
	bool "Retain per-sample PPG DC/AC series for NOR raw chunks"
	default y
	depends on APP_FEATURE_PPG
	help
	  Allocates IR/Red/Green DC and AC int32 arrays in the PPG sample
	  buffer (~12 KB at 500 samples) so vitals logging can write PPG_RAW
	  chunks with optics + DC/AC intermediates for AI export.

config PPG_PROX_ABORT_MISS_SAMPLES
	int "PPG no-contact abort threshold (consecutive missed samples)"
	default 5
	range 1 100
	depends on APP_FEATURE_PPG
	help
	  Number of consecutive no-contact proximity samples required before an
	  active PPG measurement is aborted. Lower values stop faster on finger
	  lift; higher values are more tolerant to short contact glitches.

config PPG_PROX_GUARD_ENABLE
	bool "Enable PPG proximity guard checks"
	default y
	depends on APP_FEATURE_PPG
	help
	  Enables proximity-based safeguards for PPG measurements:
	  - start-block when no contact is detected,
	  - mid-measurement abort on sustained no-contact,
	  - end-of-measurement no-contact quality override.
	  Disable this for development bring-up when you want uninterrupted
	  sampling without proximity gating.

config PPG_PROGRESS_NOTIFY_EVERY_N_SAMPLES
	int "BLE progress notify cadence (samples)"
	default 5
	range 1 100
	depends on APP_FEATURE_PPG && APP_FEATURE_BLE
	help
	  Send BLE measurement-progress notifications every N samples.
	  Lower values increase BLE/log traffic; higher values reduce overhead.

config PPG_SAMPLE_LOG_EVERY_N_SAMPLES
	int "PPG sample RTT log cadence (samples)"
	default 25
	range 1 300
	depends on APP_FEATURE_PPG
	help
	  Print "PPG sample X/Y" logs every N samples (plus startup/last sample).

config PPG_SAMPLE_LOG_INITIAL_SAMPLES
	int "PPG sample RTT initial logs"
	default 5
	range 0 50
	depends on APP_FEATURE_PPG
	help
	  Number of first samples to always log at measurement start.

config APP_FEATURE_MAX32664_UPDATE
	bool "MAX32664 firmware update + UI (umbrella)"
	default n
	depends on APP_FEATURE_DISPLAY && MAX32664
	select UI_SCREEN_MAX32664_UPDATE
	help
