menu "NiSense — optional modules (prj.conf compatibility)"

config RESOURCE
	bool "UI Resource store A/B (fonts/logos/icons; QSPI mmap)"
	default n
	help
	  Enables the Resource A/B NOR store (API: resource_*). Partition/asset
	  magic values are XIPA/XAST (on-disk identifiers).

config RESOURCE_FONTS
	bool
	default n
	depends on RESOURCE && LVGL && LV_USE_TINY_TTF
	help
	  Selected by APP_FONT_PROFILE_RESOURCE_RUNTIME only. Not a prj.conf toggle.

config RESOURCE_FONTS_RAM_CACHE
	bool "Cache the subset TTF in RAM (robust against QSPI contention/DPD)"
	depends on RESOURCE_FONTS
	default n
	help
	  Copy the subset TTF from Resource flash into a static RAM buffer at init so
	  TinyTTF never reads QSPI mid-draw. Costs RESOURCE_FONTS_RAM_CACHE_SIZE bytes
	  of RAM (~48 KB) and overflows nRF52840 with the full feature set — leave
	  n unless you have headroom. With n, glyphs are read via mmap (wake QSPI
	  via resource_wake on display resume).

config RESOURCE_FONTS_RAM_CACHE_SIZE
	int "RAM cache size for the subset TTF (bytes)"
	depends on RESOURCE_FONTS_RAM_CACHE
	default 49152
	help
	  Size of the static RAM buffer used to cache the subset TTF. Must be at
	  least as large as fonts/Montserrat-Subset.ttf; otherwise the font falls
	  back to Resource mmap reads.

config CALIBRATION
	bool "Calibration subsystem (application)"
	default n

config RESOURCE_LOG_LEVEL
	int "Resource store log level"
	default 3
	range 0 4

config CALIBRATION_LOG_LEVEL
	int "Calibration log level"
	default 3
	range 0 4

config UI_STARTUP_LOGO
	bool "Show startup logo on boot"
	default n

endmenu

menu "NiSense — thread stack tuning"

# All stack sizes here correspond to previously hard-coded values in the
# application. They are exposed as Kconfig symbols so they can be tuned from
# prj.conf against the high-watermark reported by CONFIG_APP_FEATURE_DIAG_MONITOR
# (Kconfig.diag_monitor / conf/features/diag_monitor.conf).

config GLUCOSE_UI_THREAD_STACK_SIZE
	int "glucose measurement worker thread stack size (bytes)"
	default 1536
	range 768 8192
	depends on APP_FEATURE_GLUCOSE
	help
	  Stack for the background glucose measurement thread in
	  src/ui/glucose_ui.c. The algorithm itself runs on the glucose driver
	  workq; this thread only sequences the measurement and updates the
	  UI.

config MAX32664_UPDATE_THREAD_STACK_SIZE
	int "MAX32664 firmware-update thread stack size (bytes)"
	default 2048
	range 1024 8192
	depends on APP_FEATURE_MAX32664_UPDATE
	help
	  Stack for the MAX32664 OTA firmware update worker
	  (src/ui/max32664_update_ui.c). Firmware page buffer lives in .bss;
	  this stack only holds the state machine.

config LED_STATUS_THREAD_STACK_SIZE
	int "LED status animation thread stack size (bytes)"
	default 1024
	range 512 4096
	help
	  Stack for the LED status animation thread (src/core/led_status.c).
	  Only does I2C + logging, 1 KB is plenty.

endmenu

menu "NiSense — BLE DFU"

config APP_FEATURE_BLE_DFU
	bool "BLE DFU via MCUmgr/SMP (OTA image upload)"
	default n
	depends on APP_FEATURE_BLE && BOOTLOADER_MCUBOOT
	help
	  Enables MCUmgr SMP-over-BLE transport for over-the-air firmware
	  updates.  Exposes the Nordic SMP service alongside the existing
	  custom GATT services.  The companion app uploads a signed .bin
	  image which is written to the external secondary slot; MCUboot
	  validates the RSA-2048 signature and performs the swap on the
	  next reboot.

	  Adds ~12 KB flash and ~4 KB RAM.  Keep disabled in production
	  builds where OTA is not needed.

endmenu

config BLE_PPG_STREAMING
	bool "Enable PPG raw sample BLE streaming"
	depends on BT
	default n
	help
	  Adds a PPG Raw Stream characteristic (0xf106) to the Sensor Data
	  Service. When subscribed, the device sends raw IR/Red/Green ADC
	  counts and accelerometer XYZ every Nth sample (N = PPG Stream
	  Decimation characteristic, default 3 ~= 10 Hz).
	  Increases flash by ~0.5 KB.

config BLE_ACCEL_STREAMING
	bool "Enable accelerometer XYZ BLE streaming"
	depends on BT
	default n
	help
	  Adds an Accelerometer Stream characteristic (0xf10c) to the Sensor
	  Data Service. When subscribed, the device sends LIS2DS12 XYZ samples
	  at approximately 10 Hz (every 3rd sample from the 25 Hz ODR).
	  Increases flash by ~0.3 KB.

choice BLE_SECURITY_PROFILE
	prompt "BLE GATT security profile"
	depends on BT
	default BLE_SECURITY_PROFILE_SECURE if APP_FEATURE_BLE
	default BLE_SECURITY_PROFILE_OPEN

config BLE_SECURITY_PROFILE_OPEN
	bool "Open (development — unpaired health streaming allowed)"
	help
	  Permissive GATT permissions for local development and protocol
	  bring-up. Health telemetry is readable without MITM pairing.

config BLE_SECURITY_PROFILE_SECURE
	bool "Secure (production — MITM required for health data)"
	help
	  Applies permission hardening from docs/ble/BLE_DATA_SECURITY_DATABASE.md.
	  Vitals, glucose, PPG, and sensor_all require authenticated (L3) bonds.
	  Use conf/features/ble_open.conf overlay to revert for dev builds.

endchoice

orsource "drivers/fuel_gauge/Kconfig.max20360"

menu "NiSense — UI lifecycle debug"

config APP_UI_OBJ_LIFECYCLE_DEBUG
	bool "Log LVGL widget CREATE/DELETE lifecycle (RTT)"
	default n
	depends on APP_FEATURE_DISPLAY
	help
	  When enabled, logs explicit widget creation and LV_EVENT_DELETE for
	  every object in a screen tree. Requires CONFIG_LV_USE_OBJ_NAME.
	  Per-screen DBG levels: conf/features/display.conf (CONFIG_*_UI_LOG_LEVEL_DBG).

endmenu

