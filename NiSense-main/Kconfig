config APP_FEATURE_RTT_LOG
	bool "Application RTT log feature flag"
	default n

config APP_FEATURE_FAULT_DEBUG
	bool "Fault-debug diagnostics (asserts, exception details, stack guards)"
	default n
	help
	  Enables conf/features/fault_debug.conf: MPU stack guard, fault register
	  dumps, and stack usage reporting. Kernel CONFIG_ASSERT is intentionally
	  left off — LVGL TinyTTF / stb_truetype assert() calls kernel-panic on
	  benign glyph-cache edge cases during normal UI (see issue #4).
	  STBTT_assert is softened globally when Resource TinyTTF fonts are enabled.

config APP_FEATURE_SHELL
	bool "Diagnostics shell over USB CDC VCOM"
	default n
	select APP_FEATURE_USB
	select SHELL
	select SHELL_MINIMAL
	help
	  Enables the `nisense` shell on the USB CDC-ACM VCOM. Selects
	  APP_FEATURE_USB (USBD + CDC), SHELL, and SHELL_MINIMAL (FLASH
	  budget). conf/features/shell.conf adds sizing / prompt / DTR when
	  CMake merges it.

	  Board DT always provides the CDC UART node and zephyr,shell-uart
	  (SHELL_BACKEND_SERIAL defaults on from that chosen).
	  No RTT shell — logging stays on RTT when APP_FEATURE_RTT_LOG=y.

config APP_FEATURE_FILE_SYSTEM
	bool "Filesystem + FAT storage feature (DEPRECATED / removed)"
	default n
	help
	  DEPRECATED: FatFS userdata (/NAND:) and USB-MSC export have been
	  removed. Measurement persistence uses the NOR record store; app
	  config uses NVS/settings. Leave this n.

config RECORD_STORE_SUMMARY_RESERVE
	int "Minimum pending summary slots protected from raw eviction"
	default 128
	range 8 2048
	help
	  When the record_store ring is full, raw appends will not drop the
	  oldest slot if it is a clinical summary and doing so would leave
	  fewer than this many pending summaries. Raw appends return -ENOSPC
	  instead. Summary appends may still force-drop when no other option
	  exists.

config APP_TEMP_MONITOR
	bool "Temperature monitoring (SoC die + skin sensors)"
	default y
	depends on SENSOR
	help
	  Owns the nRF52840 SoC die temperature and the MAX302xx skin temperature
	  sensors (wrist continuous + finger spot-check). Reads each sensor on its
	  correct channel, runs idle periodic sampling, appends to the NOR
	  record store, and notifies over BLE. Foundation for the agentic
	  measurement scheduler.

config APP_TEMP_IDLE_INTERVAL_SEC
	int "Idle temperature sampling interval (seconds)"
	default 60
	range 10 3600
	depends on APP_TEMP_MONITOR
	help
	  How often the SoC + wrist skin temperatures are sampled and logged when
	  no measurement cycle is running.

config APP_TEMP_SELFHEAT_COMPENSATION_X1000
	int "Wrist skin temp self-heating compensation coefficient (x1000)"
	default 0
	range 0 1000
	depends on APP_TEMP_MONITOR
	help
	  BUGFIX (2026-09-05): real exports showed skin temp running 36-41C —
	  closer to core body temperature than the ~32-35C normal for wrist
	  skin at rest — and tracking the SoC die temperature fairly closely,
	  the classic signature of the electronics' own heat bleeding into
	  the skin-contact sensor reading rather than the sensor purely
	  reading the skin.

	  When nonzero, applies: corrected_C = wrist_C - (k/1000) *
	  (soc_die_C - wrist_C), i.e. it pulls the reading down by a fraction
	  of however much hotter the die currently is than the sensor, so the
	  correction grows as the device warms up over a session rather than
	  being a fixed offset.

	  DEFAULT IS 0 (no correction) DELIBERATELY. This coefficient is a
	  real physical property of this board's specific thermal layout
	  (how well the wrist sensor is isolated from the main PCB) and can't
	  be picked correctly from firmware alone — it needs one calibration
	  session against a reference thermometer: log wrist_C and
	  soc_die_C together right after boot (die still cool) and again
	  after 30+ minutes of continuous wear (die fully warmed up),
	  compare against simultaneous reference readings (e.g. a clinical
	  IR skin thermometer) at both points, and solve for k from the two
	  data points. A wrong guess here could make readings worse, not
	  better, so this stays off until that's done — see
	  temp_snapshot_now() in src/sensors/temp.c for where it's applied.

config APP_HEALTH_SCHED
	bool "Agentic health measurement scheduler"
	default y
	depends on APP_TEMP_MONITOR
	help
	  Unified wear-gated measurement agent. Runs a sequential
	  temp -> PPG -> glucose cycle and adapts the interval based on the
	  glucose value, its rate of change, vitals, and battery state. Becomes
	  the single owner of automatic measurement timing (replaces the glucose
	  module's standalone periodic timer).

if APP_HEALTH_SCHED

config APP_HEALTH_GLUCOSE_CRIT_LOW
	int "Glucose critical-low threshold (mg/dL)"
	default 54
	range 30 90
	help
	  At/below this the scheduler jumps to the fastest cadence and alerts.

config APP_HEALTH_GLUCOSE_CRIT_HIGH
	int "Glucose critical-high threshold (mg/dL)"
	default 250
	range 180 600

config APP_HEALTH_GLUCOSE_ABN_LOW
	int "Glucose abnormal-low threshold (mg/dL)"
	default 70
	range 50 100

config APP_HEALTH_GLUCOSE_ABN_HIGH
	int "Glucose abnormal-high threshold (mg/dL)"
	default 180
	range 120 350

config APP_HEALTH_STEP_GUARD_SEC
	int "Per-step measurement guard timeout (seconds)"
	default 90
	range 20 600
	help
	  Safety timeout for each measurement step while sampling is active.
	  If a sensor never signals completion (e.g. lost skin contact mid-PPG)
	  the scheduler aborts that step and advances. Post-sample CSV flush
	  gets a separate shorter guard via APP_HEALTH_PPG_POST_GUARD_SEC.

config APP_HEALTH_PPG_SECONDS
	int "PPG acquisition window during health cycle (seconds)"
	default 32 if PPG_ALGO_RESP_ENABLED
	default 12
	range 20 32 if PPG_ALGO_RESP_ENABLED
	range 8 32
	help
	  Samples collected per health-cycle PPG step
	  (count = CONFIG_PPG_ALGO_SAMPLE_RATE × this value).

	  Tracks the same medical/algorithm windows as
	  CONFIG_PPG_ALGO_BUFFER_SECONDS:
	  - RESP on: default 32 s (800 @ 25 Hz) — this is the value that
	    actually controls how many samples a real measurement collects.
	    Raising CONFIG_PPG_ALGO_BUFFER_SECONDS alone does not change
	    this — the buffer only grows the capacity available; this is
	    the target the health-cycle scheduler actually requests.
	  - RESP off: default 12 s (EC57-oriented HR/SpO2 window).

	  Keep this aligned with the algo buffer when changing either by hand.

config APP_HEALTH_PPG_POST_GUARD_SEC
	int "PPG post-sample guard (CSV flush, seconds)"
	default 30
	range 10 120
	help
	  Re-armed when PPG sampling completes, before vitals CSV is written.
	  Covers sensor shutdown + compact CSV row. Standalone vitals (full raw
	  waveforms) are not subject to this path.

endif # APP_HEALTH_SCHED

