menu "NiSense — UI screens"

config UI_SCREEN_DEVICE_INFO
	bool
	default y
	depends on APP_FEATURE_DISPLAY
	help
	  Home screen (carousel index 0). Always compiled when display is
	  enabled — shows health summary tiles and next-scan status.
	  Not user-toggleable.

config UI_SCREEN_HOME_INFO
	bool "Home info / device identity screen"
	default n
	depends on UI_SCREEN_DEVICE_INFO
	help
	  Device identity screen (FW hash, device ID, uptime, storage).
	  Off by default — use CDC shell `nisense info` and BLE f01a instead.
	  Enable for bring-up / diagnostic builds.

config UI_SCREEN_POWER
	bool "Power summary screen"
	default n
	depends on APP_FEATURE_DISPLAY
	help
	  Battery / fuel-gauge diagnostic screen. Off by default — use
	  `nisense power` and BLE f101/f109 instead.

config UI_SCREEN_MEASURE
