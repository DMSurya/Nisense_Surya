# Experimental HUB SpO2 calibration coefficient report (AN6924 / UG-6924)
# ============================================================================
config MAX32664_HUB_SPO2_CAL_REPORT
	bool "Expose SpO2 calibration coefficient read/write (HUB)"
	default n
	depends on MAX32664_MODE_HUB
	help
	  Experimental: Family 0x50/0x51 Index 0x07 Config 0x00 — three
	  int32 coefficients (a,b,c) x 1e5. Not used by product RAW DSP path.
# Firmware Update Options (applicable to all operating modes)
# ============================================================================

config MAX32664_UPDATE_CHUNKED_WRITE
	bool "Split page writes into fixed-size chunks (multiple i2c_write calls)"
	default y
	help
	  Split the 8198-byte page write into smaller chunks, each sent as a
	  separate i2c_write() call (START + data + STOP per chunk).

	  The MAX32664 bootloader may accept STOP between chunks if it buffers
	  incoming data across transactions.  If the bootloader resets on each
	  STOP, disable this option to use a single 8198-byte i2c_write().

config MAX32664_UPDATE_CHUNK_SIZE
	int "Page write chunk size (bytes)"
	default 128
	range 8 8192
	depends on MAX32664_UPDATE_CHUNKED_WRITE
	help
	  Number of bytes per i2c_write() chunk.

config MAX32664_UPDATE_PAGE_FLASH_DELAY_MS
	int "Page write flash programming delay (ms)"
	default 2000
	range 680 5000
	help
	  How long to wait after sending a page write command before polling
	  for write status.  OEM reference uses 2000ms.  The MAX32664
	  datasheet CMD_DELAY is 680ms, but 2000ms is safer for flash erase
	  and programming variance across devices.

config MAX32664_UPDATE_PAGE_WRITE_RETRIES
	int "Page write status retry count"
	default 4
	range 1 20
	help
	  Number of times to retry the status-read when the bootloader
	  responds with SS_ERR_TRY_AGAIN (0xFE — still programming flash).
	  OEM reference uses 4 retries (SS_DEFAULT_RETRIES).  Each retry
	  adds a 200ms delay.

config MAX32664_UPDATE_IMAGE_ALLOWLIST
	bool "Level 1: allow-list GWEC / MAX86141 major-30 hub images"
	default y
	help
	  Before erase, reject .msbl packages that are not Variant C major 30
	  for MAX86141 (GWEC). Blocks common mis-flash classes: MAXM86161
	  (32.x), Variant D (40.x), and other AFE tags in the filename.

config MAX32664_UPDATE_IMAGE_SHA256
	bool "Level 2: require SHA-256 match against approved images"
	default y
	depends on MAX32664_UPDATE_IMAGE_ALLOWLIST
	help
	  Hash the full .msbl buffer before erase and compare to the baked-in
	  allow-list (ADI 30.13.31 MAX86141 C- and Z-keyed images). Required
	  when the name hint has no parseable version (e.g. app partition).

config MAX32664_UPDATE_ERASE_CMD_DELAY_MS
	int "Bootloader erase command delay before status read (ms)"
	default 1400
	range 680 5000
	help
	  ADI MAX32664 UG / SS_BOOTLOADER_ERASE_DELAY = 1400 ms. Do not
	  raise to 3 s unless a specific bootloader revision requires it.

config MAX32664_UPDATE_ERASE_POST_SETTLE_MS
	int "Extra settle after successful erase status (ms)"
	default 1400
	range 0 5000
	help
	  Additional wait after erase returns success. UG Table 9 only
	  requires CMD_DELAY on the erase command itself; keep 1400 for
	  historical safety or set 0 for UG-strict timing.

config MAX32664_UPDATE_SEND_FLASH_APP
	bool "Send Family 0x80 Index 0x06 finalize after page writes"
	default y
	help
	  UG Table 9 / ADI SampleHost flasher omit 0x80 0x06. Some images
	  still accept it. Keep enabled unless bench shows finalize fails
	  or is unnecessary for your bootloader revision.

module = LIS2DS12_ACCEL
module-str = LIS2DS12 accelerometer passthrough
source "subsys/logging/Kconfig.template.log_config"

endif # MAX32664

